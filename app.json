{
  "expo": {
    "name": "Li-Vision",
    "slug": "Li-Vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/li-vision-logo-icon.png",
    "scheme": "livisionapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10141a",
        "foregroundImage": "./assets/images/li-vision-logo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.livision"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs access to your Camera.",
          "enableCodeScanner": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/li-vision-logo-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#10141a",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      ["expo-vision-camera-v4-mediapipe/plugin", {
        "numHands": 2,
        "minDetectionConfidence": 0.4,
        "minPresenceConfidence": 0.4,
        "minTrackingConfidence": 0.4,
        "enablePose": true,
        "enableFace": true
      }],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eab06228-4837-4226-959b-d2409b196eb9"
      }
    }
  }
}
