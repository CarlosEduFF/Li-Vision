{
  "expo": {
    "name": "Li-Vision",
    "slug": "Li-Vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/images/Li-Vision(Logo-icon).png",
    //"icon": "./assets/images/Li-Vision(Logo).png",
    "scheme": "livisionapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10141a",
        "foregroundImage": "./assets/images/Li-Vision(Logo).png",
        "backgroundImage": "./assets/images/Li-Vision(Logo).png",
        "monochromeImage": "./assets/images/Li-Vision(Logo).png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.LiVision"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs access to your Camera.",
          "enableCodeScanner": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Li-Vision(Logo).png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#10141a",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/withHandLandmarker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eab06228-4837-4226-959b-d2409b196eb9"
      }
    }
  }
}
